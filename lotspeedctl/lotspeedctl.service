[Unit]
Description=LotSpeed adaptive shaper/tuner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/usr/local/bin/lotspeedctl enable eth0
ExecStart=/usr/local/bin/lotspeedctl optimize --iface eth0 --shaper --interval 5
# 护栏 4 (最外层的兜底): 无论进程是正常退出、崩溃还是被 kill, 都把整形速率写回 0。
# 内核默认 rate=0 = 完全无整形, 所以"控制器不在" 等价于"今天的行为", 而不是"卡在
# 最后一个速率上把链路勒死"。这是唯一一条不依赖控制器自身还活着的失效路径, 所以
# 它必须留在 systemd 这一层, 进程内的信号处理只是它的补充。
# `|| true` 保证 qdisc 已经被卸掉 (proc 文件不存在) 时不影响停止流程。
ExecStopPost=/bin/sh -c 'echo 0 > /proc/net/neoq_rate || true'
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
